FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY studio/requirements-studio.txt /app/studio/requirements-studio.txt
RUN python -m pip install --upgrade pip && python -m pip install -r studio/requirements-studio.txt
COPY . /app
RUN python studio/train_export.py
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=8s --start-period=120s --retries=3 CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:' + __import__('os').environ.get('PORT','8501') + '/_stcore/health',timeout=6)" || exit 1
CMD ["sh","-c","exec streamlit run studio/app.py --server.address=0.0.0.0 --server.port=${PORT:-8501} --server.headless=true --server.fileWatcherType=none"]
